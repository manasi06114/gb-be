# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS (JSON list of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Static Frontend Serving (PRD 3 single-container mode)
SERVE_FRONTEND=false
FRONTEND_STATIC_DIR=static

# Data & Snapshot Storage
DATA_DIR=data/snapshot

# Delivery Window & Cutoff Configuration
DELIVERY_START=2026-01-01
DELIVERY_END=2026-01-31
DEFAULT_CUTOFF=09:00
CUTOFF_TIMEZONE=Europe/London
AVAILABLE_CUTOFFS=["06:00", "09:00", "10:00", "12:00"]

# Elexon API Ingestion
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
CHUNK_DAYS=7
FORECAST_LOOKBACK_DAYS=10

# Admin operations (optional, leave empty to disable POST /api/admin/refresh)
ADMIN_TOKEN=secret_admin_token_change_in_prod
